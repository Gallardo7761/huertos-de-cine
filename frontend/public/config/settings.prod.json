{
    "apiConfig": {
        "baseUrl": "https://api.huertosbellavista.es/v2/cine",
        "endpoints": {
            "admin": {
                "dashboard": "/admin/dashboard"
            },
            "viewers": {
                "all": "/viewers",
                "byId": "/viewers/:userId",
                "status": "/viewers/:userId/status"
            },
            "movies": {
